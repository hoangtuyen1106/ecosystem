generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

generator docs {
  provider = "node ../../node_modules/prisma-docs-generator"
  output   = "../src/generated/docs"
}

datasource db {
  provider = "postgresql"
}

enum UserGender {
  male
  female
  other
  unknown
}

enum UserStatus {
  active
  inactive
  blocked
  pending
}

enum RoleStatus {
  active
  inactive
}

model User {
  id       String  @id @default(uuid()) @db.Uuid
  username String  @db.VarChar(50)
  email    String  @db.VarChar(255)
  password String
  deleted  Boolean @default(false)

  keycloakId String? @unique @map("keycloak_id")

  firstName     String      @map("first_name") @db.VarChar(50)
  lastName      String?     @map("last_name") @db.VarChar(50)
  avatar        String?     @db.VarChar(100)
  phone         String?     @db.VarChar(20)
  birthday      String?     @db.VarChar(50)
  gender        UserGender?
  status        UserStatus  @default(active)
  searchUnicode String?     @map("search_unicode") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles       UserRole[]
  roleAuthor Role[]

  @@index([status])
  @@index([firstName, lastName])
  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?    @db.VarChar(255)
  status      RoleStatus @default(active)

  users       UserRole[]
  permissions String[]   @default([])

  searchUnicode String? @map("search_unicode") @db.VarChar(255)

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId Int    @map("role_id")

  user User @relation(references: [id], fields: [userId], onUpdate: Restrict)
  role Role @relation(references: [id], fields: [roleId], onUpdate: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

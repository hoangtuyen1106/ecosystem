generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

generator docs {
  provider = "node ../../node_modules/prisma-docs-generator"
  output   = "../src/generated/docs"
}

datasource db {
  provider = "postgresql"
}

enum UserGender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  username String @unique
  email    String @unique
  password String

  keycloakId String? @unique @map("keycloak_id")

  firstName String      @map("first_name") @db.VarChar(50)
  lastName  String?     @map("last_name") @db.VarChar(50)
  avatar    String?     @db.VarChar(100)
  phone     String?     @db.VarChar(20)
  birthday  String?     @db.VarChar(50)
  gender    UserGender?
  status    UserStatus  @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles UserRole[] @relation("UserRoles")

  @@index([status])
  @@index([firstName, lastName])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  active      Boolean  @default(true)

  users UserRole[] @relation("UserRoles")
  permissions RolePermission[] @relation("RolePermissions")

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId Int @map("role_id")

  user User @relation("UserRoles", references: [id], fields: [userId])
  role Role @relation("UserRoles", references: [id], fields: [roleId])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  active      Boolean  @default(true)

  roles RolePermission[] @relation("RolePermissions")

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation("RolePermissions", references: [id], fields: [roleId])
  permission Permission @relation("RolePermissions", references: [id], fields: [permissionId])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}
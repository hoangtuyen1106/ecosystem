generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

generator docs {
  provider = "node ../../node_modules/prisma-docs-generator"
  output   = "../src/generated/docs"
}

datasource db {
  provider = "postgresql"
}

enum UserGender {
  MALE    @map("male")
  FEMALE  @map("female")
  OTHER   @map("other")
  UNKNOWN @map("unknown")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  BLOCKED  @map("blocked")
  PENDING  @map("pending")
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  username String @unique
  email    String @unique
  password String

  keycloakId String? @unique @map("keycloak_id")

  firstName String      @map("first_name") @db.VarChar(50)
  lastName  String?     @map("last_name") @db.VarChar(50)
  avatar    String?     @db.VarChar(100)
  phone     String?     @db.VarChar(20)
  birthday  String?     @db.VarChar(50)
  gender    UserGender?
  status    UserStatus  @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles        UserRole[] @relation("UserRoles")
  createdRoles Role[]     @relation("RoleCreatedBy")

  @@index([status])
  @@index([firstName, lastName])
  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.VarChar(255)
  active      Boolean @default(true)

  users       UserRole[] @relation("UserRoles")
  permissions String[]   @default([])

  createdBy String?  @map("created_by") @db.Uuid
  created   User?    @relation("RoleCreatedBy", fields: [createdBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId Int    @map("role_id")

  user User @relation("UserRoles", references: [id], fields: [userId])
  role Role @relation("UserRoles", references: [id], fields: [roleId])

  @@id([userId, roleId])
  @@map("user_roles")
}
